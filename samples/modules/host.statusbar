# Module: host. macOS/Linux; whoami and hostname.
# Load: statusbar config --add host < host.statusbar

[line.<module>.identity]
text = " #[fg=colour5]host#[default] #[fg=colour4,bold]#(command:<module>.identity)#[default]#(fill: ) "

[command.<module>.identity]
run = |
  user=$(whoami) && host=$(hostname -s) || { printf 'unavailable'; exit; }
  printf '%s@%s' "$user" "$host"
interval = 3600
