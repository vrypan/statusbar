# Module: weather. macOS/Linux; curl, tr; network request to wttr.in.
# The service guesses location from your IP. Set location to e.g. Athens.
# Load: statusbar config import weather.statusbar

[line.weather.current]
default = "#[track]#(command:weather.current)#[notrack]"
text = "#[default,fg=colour8,fg=muted,bold]* Weather: #[nobold]#(value) #[default,fg=colour8,fg=rule,dim]#(fill:·)#[default]"

[command.weather.current]
run = |
  location=""
  command -v curl >/dev/null 2>&1 || { printf 'install curl'; exit; }
  result=$(curl -fsSL --connect-timeout 3 --max-time 8 --get "https://wttr.in/$location" --data-urlencode 'format=%c %t') || { printf 'unavailable'; exit; }
  [ -n "$result" ] || { printf 'unavailable'; exit; }
  printf '%s' "$result" | tr '\r\n' '  '
interval = 300
