# Native palette variant of multi-line.config.
# Colors follow the terminal theme; see README.md for palette mappings.
# Adapted from a real day-to-day configuration and shared as a practical
# multi-line example.
#
# Requirements:
# - curl, jq, uptime, awk, and the GitHub CLI (`gh`)
# - an authenticated GitHub CLI (`gh auth login`) for notifications
# - network access for Hacker News, GitHub, and wttr.in
# - optional Starship integration for slot 3; without it, line 2's left is blank
#
# The `#[track]...#[notrack]` regions pulse when their displayed content
# changes. Their first result establishes a baseline and does not pulse.

interval = 5

[colors]
base = default
text = default
accent = colour3
muted = colour8
pill = colour8
good = colour2
success = colour10
failure = colour1

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=text
left = "#[fg=accent]#(spinner)#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "#[fg=muted]·#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=failure]exit #(exit_code)#[default]"

[line.1]
left = ""
rule = " "
style = fg=pill,dim

# Slot 3 is intentionally empty here: Starship fills it.
[line.2]
left = ""
right = "#[fg=pill] (load #(load))#[default]"
style = fg=text

# Dim the rules while keeping slot text at normal brightness.
[line.3]
  left = "#[track]#[fg=text,nodim,bold]*#[nobold] #(hn)#[notrack]"
  right = "#[fg=muted,nodim] (HackerNews)"
  rule = ·
  style = fg=pill,dim

[line.4]
  left = "#[track]#[fg=text,nodim,bold]*#[nobold] #(gh-notification)#[notrack] "
  right = "#[fg=muted,nodim] (GitHub)"
  rule = ·
  style = fg=pill,dim

[line.5]
  left = "#[fg=text,nodim,bold]*#[nobold] Now "
  right = " #[fg=muted,nodim] #(weather) #(datetime:%a %d %H:%M:%S)"
  rule = ·
  style = fg=pill,dim

[command.hn]
run = |
  id=$(curl -fsSL https://hacker-news.firebaseio.com/v0/topstories.json | jq -r '.[0]') || exit
  json=$(curl -fsSL https://hacker-news.firebaseio.com/v0/item/$id.json) || exit
  title=$(printf %s "$json" | jq -r '.title // empty') || exit
  printf '\033]8;;https://news.ycombinator.com/item?id=%s\033\\%s\033]8;;\033\\' "$id" "$title"
interval = 60

[command.gh-notification]
run = |
  notification=$(GH_NO_UPDATE_NOTIFIER=1 gh api notifications --cache 60s | jq -c '.[0]') || { printf 'GitHub unavailable'; exit; }
  case $notification in ''|null) printf 'Zero Inbox'; exit;; esac
  title=$(printf %s "$notification" | jq -r '"\(.repository.full_name): \(.subject.title)"')
  subject_url=$(printf %s "$notification" | jq -r '.subject.url // empty')
  url=""
  if [ -n "$subject_url" ]; then
    url=$(GH_NO_UPDATE_NOTIFIER=1 gh api "$subject_url" --jq '.html_url // empty' 2>/dev/null)
  fi
  [ -n "$url" ] || url=$(printf %s "$notification" | jq -r '.repository.html_url')
  printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$title"
interval = 60

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
