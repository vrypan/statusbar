# Inspired by https://starship.rs/presets/pure-preset
# Transparent, restrained; no Powerline font required.
interval = 5

[colors]
accent = #c792ea
muted = #737b91
blue = #82aaff
success = #9ece6a
failure = #f7768e

[line.rule]
text = "#[fg=muted]#(fill:─)"

# Show user/host/load until Starship or `set prompt` supplies a value.
[line.prompt]
default = "#[fg=muted]#(command:system.user)@#[fg=blue,bold]#(command:system.host)#[default]  #[fg=muted]load #[default]#(command:system.load)"
text = "#[default] #(value)"
# Reset value styles before filling the gap and drawing the right side.
text .= "#[default]#(fill: )"
text .= "#[fg=muted]#(command:system.weather)  #(datetime:%a %d)  #[fg=accent,bold]#(datetime:%H:%M:%S)#[default] "

# Lines created by `statusbar push`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=blue]#(spinner)#[fg=muted] #[fg=accent,bold]#(name)#[default,fg=muted] › #(value)#(fill: )"
done = "#[fg=muted]· #[fg=accent,bold]#(name)#[default,fg=muted] › #(value)#(fill: )"
success = "#[fg=success]✔#[fg=muted] #[fg=accent,bold]#(name)#[default,fg=muted] › #(value)#(fill: )"
failed = "#[fg=failure]✗#[fg=muted] #[fg=accent,bold]#(name)#[default,fg=muted] › #(value)#(fill: )#[fg=failure]failed#[default]"

[command.system.user]
run = whoami
interval = 3600

[command.system.host]
run = hostname -s
interval = 3600

[command.system.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.system.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
