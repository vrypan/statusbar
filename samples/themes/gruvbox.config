# Inspired by https://starship.rs/presets/gruvbox-rainbow
# Warm rounded segments; requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
base = #3c3836
text = #fbf1c7
orange = #d65d0e
yellow = #d79921
aqua = #689d6a
muted = #bdae93
success = #b8bb26
failure = #fb4934

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted,bg=base
left = "#[fg=yellow]#(spinner)#[default] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "· [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[default] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[default] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=failure]exit #(exit_code)#[default]"

[line.1]
rule = ━
style = fg=yellow

[line.2]
style = fg=text,bg=base
left = "#[fg=orange]#[fg=text,bg=orange,bold] #(whoami) #[fg=orange,bg=yellow,nobold]#[fg=base,bg=yellow,bold] #(hostname -s) #[fg=yellow,bg=aqua,nobold]#[fg=base,bg=aqua] load #(load) #[fg=aqua,bg=base,nobold]#[default]"
right = "#[fg=aqua]#[fg=base,bg=aqua] #(weather) #[fg=aqua,bg=yellow,nobold]#[fg=base,bg=yellow,bold] %H:%M:%S #[fg=yellow,bg=base,nobold]#[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
