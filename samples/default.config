# statusbar config
#
# This is statusbar's built-in config, used when there is no config file.
# Copy it to ~/.config/statusbar/config (or point --config or
# $STATUSBAR_CONFIG at it) to make your own.
#
# Comments start a line with # or ;. A # anywhere else is part of the value,
# since markup and colors use it.

# Refresh for commands that don't set their own interval, in seconds.
interval = 5

# The bar's height is the number of consecutive [line.N] sections below.

# Style for lines without their own, e.g. a background: bg=#1e1e2e
# style =

[colors]
accent = yellow
dim    = brightblack
rule   = brightblack

# Line 1 is the bar's upper row: a thin rule between the shell and the bar.
[line.1]
rule  = ─
style = fg=rule

# Line 2: user, host and load on the left; date and time on the right.
# Quotes keep the padding spaces at the edges.
#
# Commands here run in statusbar's working directory, not your shell's, so
# they can't follow `cd`. For per-directory information such as a git
# branch, update the bar from your shell instead: `statusbar set N TEXT`.
# Line 1 is slots 1/2 and line 2 is slots 3/4; no TEXT restores the config.
# `eval "$(statusbar init zsh)"` moves starship's prompt into slot 3.
#
#   #(name)      first line of [command.name]'s output
#   #(command)   any other text runs as a shell command at `interval`
#   %H:%M        strftime(3) conversions; %% is a literal %
#   #[...]       markup: fg=, bg=, bold, italics, default, ...
[line.2]
left  = " #[fg=dim]#(whoami)@#[default]#[fg=accent,bold]#(hostname -s)#[default] #[fg=dim]· load#[default] #(load)"
right = "%a %d %b  #[bold]%H:%M:%S#[default] "

# The 1-minute load average, on macOS and Linux.
[command.load]
run      = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10
