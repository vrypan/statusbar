# Module: host. macOS/Linux; whoami and hostname.
# Load: statusbar config --add < host.statusbar

[line.host.identity]
default = " #[fg=colour5]host#[default] #[fg=colour4,bold]#(command:host.identity)#[default]#(fill: ) "
text = "#(value)"

[command.host.identity]
run = |
  user=$(whoami) && host=$(hostname -s) || { printf 'unavailable'; exit; }
  printf '%s@%s' "$user" "$host"
interval = 3600
