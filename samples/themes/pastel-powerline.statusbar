# Inspired by https://starship.rs/presets/pastel-powerline
# Requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
base = #252334
text = #eee9f5
purple = #9a348e
rose = #da627d
peach = #fca17d
blue = #86bbd8
muted = #b8afc8
success = #a8d5ba
failure = #da627d

[line.rule]
text = "#[fg=rose]#(fill:─)"

# Starship's prompt details (the line's value) come first.
[line.prompt]
text = "#[fg=text,bg=base]#(value)"
text .= "#[fg=text,bg=purple,bold] #(command:user) #[fg=purple,bg=rose,nobold]#[fg=base,bg=rose,bold] #(command:host) "
text .= "#[fg=rose,bg=peach,nobold]#[fg=base,bg=peach] load #(command:load) #[fg=peach,bg=base]#[default,fg=text,bg=base]"
text .= "#(fill: )"
text .= "#[fg=muted]#(command:weather)  #(datetime:%a %d) #[fg=blue,bg=base]#[fg=base,bg=blue,bold] #(datetime:%H:%M:%S) #[default,fg=text,bg=base]"

# Lines created by `statusbar push`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=muted,bg=base]#[fg=rose]#(spinner)#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
done = "#[fg=muted,bg=base]· #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
success = "#[fg=muted,bg=base]#[fg=success]✔#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
failed = "#[fg=muted,bg=base]#[fg=failure]✗#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )#[fg=failure,bg=base]#[fg=base,bg=failure,bold] failed #[default,fg=muted,bg=base]"

[command.user]
run = whoami
interval = 3600

[command.host]
run = hostname -s
interval = 3600

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
