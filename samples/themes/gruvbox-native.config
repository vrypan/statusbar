# Native palette variant of gruvbox.config.
# Colors follow the terminal theme; see README.md for palette mappings.
# Inspired by https://starship.rs/presets/gruvbox-rainbow
# Red/yellow/cyan rounded segments; requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
# Default row background; explicit palette colors for text on colored badges.
base = default
text = default
orange = colour1
yellow = colour3
aqua = colour6
muted = colour8
badge_text = colour0
segment_text = colour15
success = colour10
failure = colour1

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted,bg=base
left = "#[fg=yellow]#(spinner)#[default] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "· [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[default] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[default] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=failure]exit #(exit_code)#[default]"

[line.1]
rule = ━
style = fg=yellow

[line.2]
style = fg=text,bg=base
left = "#[fg=orange]#[fg=segment_text,bg=orange,bold] #(whoami) #[fg=orange,bg=yellow,nobold]#[fg=badge_text,bg=yellow,bold] #(hostname -s) #[fg=yellow,bg=aqua,nobold]#[fg=badge_text,bg=aqua] load #(load) #[fg=aqua,bg=base,nobold]#[default]"
right = "#[fg=aqua]#[fg=badge_text,bg=aqua] #(weather) #[fg=aqua,bg=yellow,nobold]#[fg=badge_text,bg=yellow,bold] %H:%M:%S #[fg=yellow,bg=base,nobold]#[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
