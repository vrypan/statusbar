interval = 5
style = bg=#1e1e2e,fg=#cdd6f4

[colors]
accent = #89b4fa
muted = #6c7086

[line.push]
style = fg=accent,bg=#1e1e2e

[line.1]
left = " Build "
right = " ready "
rule = ─
style = fg=muted

[line.2]
left = " #[fg=accent,bold]#(hostname -s)#[default]"
right = " %H:%M "

[line.3]
left = " #(pwd)"
right = " #(git branch --show-current 2>/dev/null) "
