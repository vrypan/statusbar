# Start with: statusbar --config samples/spinner.config
# Inside the session, try: statusbar push -t wait -- sleep 3
[line.1]
left = "statusbar"

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
spinner_interval = 0.1
left = "#(spinner) [#(id)] #(tag) > #(stream)"

[line.push.done]
left = "· [#(id)] #(tag) > #(stream)"

[line.push.success]
left = "#[fg=green]✓#[default] [#(id)] #(tag) > #(stream)"

[line.push.failed]
left = "#[fg=red]✗#[default] [#(id)] #(tag) > #(stream)"
right = "exit #(exit_code)"
