# statusbar config
#
# This is statusbar's built-in config, used when there is no config file.
# Copy it to ~/.config/statusbar/config.statusbar (or point --config or
# $STATUSBAR_CONFIG at it) to make your own.
#
# Comments start a line with # or ;. A # anywhere else is part of the value,
# since markup and colors use it. Quotes keep spaces at the edges of a value.

# Refresh for commands that don't set their own interval, in seconds.
interval = 5

# The base style of the whole bar, e.g. a background: fg=white,bg=#1e1e2e.
# Inline #[default] and cells the text leaves empty use it.
# style =

[colors]
text = default
muted = colour8
rule = colour8
accent = colour3
success = colour10
failure = colour1

# Regions pulse using their own foreground/background and the terminal palette.
# The first result establishes a baseline without highlighting.
[highlight]
# Each pulse lasts 1.2 seconds; choose 1, 2, or 3.
pulses = 2

# Lines appear in the order their [line.NAME] sections are declared.
# A line's text is a template:
#
#   #(value)            the explicit value, or the expanded `default` template
#   #(name) #(status)   its name and status (normal, running, done, ...)
#   #(fill:─)           repeat ─ across the free width; text after it is
#                       right-aligned. Without a fill, text is left-aligned.
#   #(command:system.load)
#                       first line of [command.system.load]'s output
#   #(datetime:%H:%M)   local time via strftime(3); %% is a literal %
#   #(terminal:cols)    outer terminal columns (also rows, content_rows)
#   #[...]              style: fg=, bg=, bold, italics, default, ...
#   #[track]..#[notrack] pulse when this part changes
#   ##                  a literal #
#
# running =, done =, success = and failed = replace text while the line has
# that status, e.g. after `statusbar update NAME --status success`.

# A rule separating the shell from the statusbar.
[line.rule]
text = "#[fg=rule,dim]#(fill:─)#[default]"

# `eval "$(statusbar init zsh)"` moves Starship's prompt details into this
# line's value, on the left. Commands here run in statusbar's working
# directory, not your shell's, so they can't follow `cd`; update the bar from
# your shell instead: `statusbar update prompt TEXT`.
# Until a value is set, show user/host/load. `update prompt --reset` restores it.
[line.prompt]
default = "#[fg=muted,bold]* Host: #[nobold]#(command:system.user)@#(command:system.host)"
default .= "  load #[track]#(command:system.load)#[notrack]"
text = "#[fg=text]#(value) #[default,fg=rule,dim]#(fill:·)"
text .= "#[default,fg=muted] #(datetime:%a %d %b) #[track]#(datetime:%H:%M)#[notrack]#[default]"

# Temporary lines use the same muted labels as modules.
[push]
keep = left
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=accent]#(spinner)#[default,fg=muted] #[bold]#(name)#[nobold] › #(value) #[default,fg=rule,dim]#(fill:·)#[default]"
done = "#[fg=muted]· #[bold]#(name)#[nobold] › #(value) #[default,fg=rule,dim]#(fill:·)#[default]"
success = "#[fg=success]✔#[default,fg=muted] #[bold]#(name)#[nobold] › #(value) #[default,fg=rule,dim]#(fill:·)#[default]"
failed = "#[fg=failure]✗#[default,fg=muted] #[bold]#(name)#[nobold] › #(value) #[default,fg=rule,dim]#(fill:·)#[default,fg=failure] failed#[default]"

[command.system.user]
run      = whoami
interval = 3600

[command.system.host]
run      = hostname -s
interval = 3600

# The 1-minute load average, on macOS and Linux.
[command.system.load]
run      = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10
