# Inspired by https://starship.rs/presets/pure-preset
# Transparent, restrained; no Powerline font required.
interval = 5

[colors]
accent = #c792ea
muted = #737b91
blue = #82aaff

[line.1]
rule = ─
style = fg=muted

[line.2]
left = " #[fg=muted]#(whoami)@#[fg=blue,bold]#(hostname -s)#[default]  #[fg=muted]load #[default]#(load)"
right = "#[fg=muted]#(weather)  %a %d  #[fg=accent,bold]%H:%M:%S#[default] "

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t%m"
interval = 300
