# Native palette variant of tokyo-night.config.
# Colors follow the terminal theme; see README.md for palette mappings.
# Inspired by https://starship.rs/presets/tokyo-night
# Blue badges, terminal background, and a dim half-block border.
interval = 5

[colors]
# Default row background; explicit palette colors for text on colored badges.
base = default
text = default
muted = colour8
accent = colour12
border = colour8
badge_text = colour0
error_text = colour15
success = colour10
failure = colour1

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted,bg=base
left = "#[fg=accent]#(spinner)#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "#[fg=muted]·#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=error_text,bg=failure,bold] exit #(exit_code) #[default]"

[line.1]
rule = ▀
style = fg=border,bg=base,dim

[line.2]
style = fg=text,bg=base
left = "#[fg=badge_text,bg=accent,bold] #(whoami)@#(hostname -s) #[default]  #[fg=muted]load #[fg=accent]#(load)#[default]"
right = "#[fg=muted]#(weather)  %a %d #[default] #[fg=badge_text,bg=accent,bold] %H:%M:%S #[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
