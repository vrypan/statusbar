# Native palette variant of pastel-powerline.config.
# Colors follow the terminal theme; see README.md for palette mappings.
# Inspired by https://starship.rs/presets/pastel-powerline
# Requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
# Default row background; explicit palette colors for text on colored badges.
base = default
text = default
purple = colour5
rose = colour13
peach = colour11
blue = colour12
muted = colour8
badge_text = colour0
error_text = colour15
segment_text = colour15
success = colour10
failure = colour1

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted,bg=base
left = "#[fg=rose]#(spinner)#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "#[fg=muted]·#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=failure,bg=base]#[fg=error_text,bg=failure,bold] exit #(exit_code) #[default]"

[line.1]
rule = ─
style = fg=rose

[line.2]
style = fg=text,bg=base
left = "#[fg=segment_text,bg=purple,bold] #(whoami) #[fg=purple,bg=rose,nobold]#[fg=badge_text,bg=rose,bold] #(hostname -s) #[fg=rose,bg=peach,nobold]#[fg=badge_text,bg=peach] load #(load) #[fg=peach,bg=base]#[default]"
right = "#[fg=muted]#(weather)  #(datetime:%a %d) #[fg=blue,bg=base]#[fg=badge_text,bg=blue,bold] #(datetime:%H:%M:%S) #[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
