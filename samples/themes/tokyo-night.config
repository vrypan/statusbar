# Inspired by https://starship.rs/presets/tokyo-night
# Cool blue badge, dark background, half-block border.
interval = 5

[colors]
base = #1d2230
text = #c0caf5
muted = #a0a9cb
accent = #769ff0
border = #394260
success = #9ece6a
failure = #f7768e

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted,bg=base
left = "#[fg=accent]#(spinner)#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "#[fg=muted]·#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=base,bg=failure,bold] exit #(exit_code) #[default]"

[line.1]
rule = ▀
style = fg=border,bg=base

[line.2]
style = fg=text,bg=base
left = "#[fg=base,bg=accent,bold] #(whoami)@#(hostname -s) #[default]  #[fg=muted]load #[fg=accent]#(load)#[default]"
right = "#[fg=muted]#(weather)  %a %d #[default] #[fg=base,bg=accent,bold] %H:%M:%S #[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
