# Inspired by https://starship.rs/presets/pure-preset
# Transparent, restrained; no Powerline font required.
interval = 5

[colors]
accent = #c792ea
muted = #737b91
blue = #82aaff
success = #9ece6a
failure = #f7768e

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted
left = "#[fg=blue]#(spinner)#[fg=muted] [#(id)] #[fg=accent,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "#[fg=muted]·#[fg=muted] [#(id)] #[fg=accent,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[fg=muted] [#(id)] #[fg=accent,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[fg=muted] [#(id)] #[fg=accent,bold]#(tag)#[default] › #(stream)"
right = "#[fg=failure]exit #(exit_code)#[default]"

[line.1]
right = "⡎⠉⠉⢱" 

[line.2]
left  = "<starship placeholder>"
right = "⢇⣒⣒⡸"
