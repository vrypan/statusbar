# Inspired by https://starship.rs/presets/pastel-powerline
# Requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
base = #252334
text = #eee9f5
purple = #9a348e
rose = #da627d
peach = #fca17d
blue = #86bbd8
muted = #b8afc8
success = #a8d5ba
failure = #da627d

[line.rule]
text = "#[fg=rose]#(fill:─)"

# Show user/host/load until Starship or `update prompt` supplies a value.
[line.prompt]
default = "#[fg=text,bg=purple,bold] #(command:system.user) #[fg=base,bg=rose] #(command:system.host) "
default .= "#[fg=base,bg=peach,nobold] load #(command:system.load) "
text = "#[default,fg=text,bg=base]#(value)"
# Reset value styles before filling the gap and drawing the right side.
text .= "#[default,fg=text,bg=base]#(fill: )"
text .= "#[fg=muted]#(command:system.weather)  #(datetime:%a %d) #[fg=base,bg=blue,bold] #(datetime:%H:%M:%S) #[default,fg=text,bg=base]"

# Lines created by `statusbar new`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=muted,bg=base]#[fg=rose]#(spinner)#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
done = "#[fg=muted,bg=base]· #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
success = "#[fg=muted,bg=base]#[fg=success]✔#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
failed = "#[fg=muted,bg=base]#[fg=failure]✗#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )#[fg=failure,bg=base]#[fg=base,bg=failure,bold] failed #[default,fg=muted,bg=base]"

[command.system.user]
run = whoami
interval = 3600

[command.system.host]
run = hostname -s
interval = 3600

[command.system.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.system.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
