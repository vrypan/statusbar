# Native palette variant of multi-line.statusbar.
# Colors follow the terminal theme; see README.md for palette mappings.
# Adapted from a real day-to-day configuration and shared as a practical
# multi-line example.
#
# Requirements:
# - curl, jq, uptime, awk, and the GitHub CLI (`gh`)
# - an authenticated GitHub CLI (`gh auth login`) for notifications
# - network access for Hacker News, GitHub, and wttr.in
# - optional Starship integration for the prompt line; without it, its left
#   side is blank
#
# The `#[track]...#[notrack]` regions pulse when their displayed content
# changes. Their first result establishes a baseline and does not pulse.

interval = 5

[colors]
base = default
text = default
accent = colour3
muted = colour8
pill = colour8
good = colour2
success = colour10
failure = colour1

# A blank separator above the bar's content.
[line.spacer]
text = ""

# Starship fills this line's value.
[line.prompt]
text = "#[fg=text]#(value)#(fill: )#[fg=pill] (load #(command:system.load))#[default,fg=text]"

# Dim the dotted fills while keeping the text at normal brightness.
[line.hn.top]
text = "#[fg=pill,dim]#[track]#[fg=text,nodim,bold]*#[nobold] #(command:hn.top)#[notrack]#[default,fg=pill,dim]#(fill:·)#[fg=muted,nodim] (HackerNews)"

[line.gh.notifications]
text = "#[fg=pill,dim]#[track]#[fg=text,nodim,bold]*#[nobold] #(command:gh.notifications)#[notrack] #[default,fg=pill,dim]#(fill:·)#[fg=muted,nodim] (GitHub)"

[line.system.now]
text = "#[fg=pill,dim]#[fg=text,nodim,bold]*#[nobold] Now #[default,fg=pill,dim]#(fill:·) #[fg=muted,nodim] #(command:system.weather) #(datetime:%a %d %H:%M:%S)"

# Lines created by `statusbar push`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=text]#[fg=accent]#(spinner)#[fg=muted] #[fg=text,bold]#(name)#[default,fg=text] › #(value)#(fill: )"
done = "#[fg=text]#[fg=muted]· #[fg=text,bold]#(name)#[default,fg=text] › #(value)#(fill: )"
success = "#[fg=text]#[fg=success]✔#[fg=muted] #[fg=text,bold]#(name)#[default,fg=text] › #(value)#(fill: )"
failed = "#[fg=text]#[fg=failure]✗#[fg=muted] #[fg=text,bold]#(name)#[default,fg=text] › #(value)#(fill: )#[fg=failure]failed#[default,fg=text]"

[command.hn.top]
run = |
  id=$(curl -fsSL https://hacker-news.firebaseio.com/v0/topstories.json | jq -r '.[0]') || exit
  json=$(curl -fsSL https://hacker-news.firebaseio.com/v0/item/$id.json) || exit
  title=$(printf %s "$json" | jq -r '.title // empty') || exit
  printf '\033]8;;https://news.ycombinator.com/item?id=%s\033\\%s\033]8;;\033\\' "$id" "$title"
interval = 60

[command.gh.notifications]
run = |
  notification=$(GH_NO_UPDATE_NOTIFIER=1 gh api notifications --cache 60s | jq -c '.[0]') || { printf 'GitHub unavailable'; exit; }
  case $notification in ''|null) printf 'Zero Inbox'; exit;; esac
  title=$(printf %s "$notification" | jq -r '"\(.repository.full_name): \(.subject.title)"')
  subject_url=$(printf %s "$notification" | jq -r '.subject.url // empty')
  url=""
  if [ -n "$subject_url" ]; then
    url=$(GH_NO_UPDATE_NOTIFIER=1 gh api "$subject_url" --jq '.html_url // empty' 2>/dev/null)
  fi
  [ -n "$url" ] || url=$(printf %s "$notification" | jq -r '.repository.html_url')
  printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$title"
interval = 60

[command.system.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.system.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
