# Native palette variant of tokyo-night.statusbar.
# Colors follow the terminal theme; see README.md for palette mappings.
# Inspired by https://starship.rs/presets/tokyo-night
# Blue badges, terminal background, and a dim half-block border.
interval = 5

[colors]
# Default row background; explicit palette colors for text on colored badges.
base = default
text = default
muted = colour8
accent = colour12
border = colour8
badge_text = colour0
error_text = colour15
success = colour10
failure = colour1

[line.border]
text = "#[fg=border,bg=base,dim]#(fill:▀)"

# Show user/host/load until Starship or `set prompt` supplies a value.
[line.prompt]
default = "#[fg=badge_text,bg=accent,bold] #(command:system.user)@#(command:system.host) #[default,fg=text,bg=base]  #[fg=muted]load #[fg=accent]#(command:system.load)"
text = "#[default,fg=text,bg=base]#(value)"
# Reset value styles before filling the gap and drawing the right side.
text .= "#[default,fg=text,bg=base]#(fill: )"
text .= "#[fg=muted]#(command:system.weather)  #(datetime:%a %d) #[default,fg=text,bg=base] #[fg=badge_text,bg=accent,bold] #(datetime:%H:%M:%S) #[default,fg=text,bg=base]"

# Lines created by `statusbar push`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=muted,bg=base]#[fg=accent]#(spinner)#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
done = "#[fg=muted,bg=base]· #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
success = "#[fg=muted,bg=base]#[fg=success]✔#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
failed = "#[fg=muted,bg=base]#[fg=failure]✗#[fg=muted] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )#[fg=error_text,bg=failure,bold] failed #[default,fg=muted,bg=base]"

[command.system.user]
run = whoami
interval = 3600

[command.system.host]
run = hostname -s
interval = 3600

[command.system.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.system.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
