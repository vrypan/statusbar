# Native palette variant of gruvbox.statusbar.
# Colors follow the terminal theme; see README.md for palette mappings.
# Inspired by https://starship.rs/presets/gruvbox-rainbow
# Red/yellow/cyan rounded segments; requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
# Default row background; explicit palette colors for text on colored badges.
base = default
text = default
orange = colour1
yellow = colour3
aqua = colour6
muted = colour8
badge_text = colour0
segment_text = colour15
success = colour10
failure = colour1

[line.rule]
text = "#[fg=yellow]#(fill:━)"

# Starship's prompt details (the line's value) come first.
[line.prompt]
text = "#[fg=text,bg=base]#(value)"
text .= "#[fg=orange]#[fg=segment_text,bg=orange,bold] #(command:user) #[fg=orange,bg=yellow,nobold]#[fg=badge_text,bg=yellow,bold] #(command:host) "
text .= "#[fg=yellow,bg=aqua,nobold]#[fg=badge_text,bg=aqua] load #(command:load) #[fg=aqua,bg=base,nobold]#[default,fg=text,bg=base]"
text .= "#(fill: )"
text .= "#[fg=aqua]#[fg=badge_text,bg=aqua] #(command:weather) #[fg=aqua,bg=yellow,nobold]#[fg=badge_text,bg=yellow,bold] #(datetime:%H:%M:%S) #[fg=yellow,bg=base,nobold]#[default,fg=text,bg=base]"

# Lines created by `statusbar push`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=muted,bg=base]#[fg=yellow]#(spinner)#[default,fg=muted,bg=base] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
done = "#[fg=muted,bg=base]· #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
success = "#[fg=muted,bg=base]#[fg=success]✔#[default,fg=muted,bg=base] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
failed = "#[fg=muted,bg=base]#[fg=failure]✗#[default,fg=muted,bg=base] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )#[fg=failure]failed#[default,fg=muted,bg=base]"

[command.user]
run = whoami
interval = 3600

[command.host]
run = hostname -s
interval = 3600

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
