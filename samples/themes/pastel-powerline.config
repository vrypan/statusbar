# Inspired by https://starship.rs/presets/pastel-powerline
# Requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
base = #252334
text = #eee9f5
purple = #9a348e
rose = #da627d
peach = #fca17d
blue = #86bbd8
muted = #b8afc8
success = #a8d5ba
failure = #da627d

[line.push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
style = fg=muted,bg=base
left = "#[fg=rose]#(spinner)#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = ""

# Completion settings inherit from [line.push], then [line.push.done].
[line.push.done]
left = "#[fg=muted]·#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.success]
left = "#[fg=success]✔#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"

[line.push.failed]
left = "#[fg=failure]✗#[fg=muted] [#(id)] #[fg=text,bold]#(tag)#[default] › #(stream)"
right = "#[fg=failure,bg=base]#[fg=base,bg=failure,bold] exit #(exit_code) #[default]"

[line.1]
rule = ─
style = fg=rose

[line.2]
style = fg=text,bg=base
left = "#[fg=text,bg=purple,bold] #(whoami) #[fg=purple,bg=rose,nobold]#[fg=base,bg=rose,bold] #(hostname -s) #[fg=rose,bg=peach,nobold]#[fg=base,bg=peach] load #(load) #[fg=peach,bg=base]#[default]"
right = "#[fg=muted]#(weather)  %a %d #[fg=blue,bg=base]#[fg=base,bg=blue,bold] %H:%M:%S #[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
