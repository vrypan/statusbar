# Module: load. macOS/Linux; uptime and awk. Load is not CPU percentage.
# Load: statusbar config import load.statusbar

[line.load.average]
default = "#[track]#(command:load.average)#[notrack] (1 / 5 / 15 min)"
text = "#[default,fg=colour8,fg=muted,bold]* Load: #[nobold]#(value) #[default,fg=colour8,fg=rule,dim]#(fill:·)#[default]"

[command.load.average]
run = |
  LC_ALL=C uptime | awk -F'load averages?: ' '
    NF==2 {gsub(/,/, " ", $2); n=split($2,a,/[[:space:]]+/); out=""
      for(i=1;i<=n;i++)if(a[i] ~ /^[0-9]+([.][0-9]+)?$/){out=out (out=="" ? "" : "  ") a[i]; count++}
      if(count==3){printf "%s",out; found=1}}
    END {if(!found)printf "unavailable"}'
interval = 10
