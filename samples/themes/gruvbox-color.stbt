# Inspired by https://starship.rs/presets/gruvbox-rainbow
# Warm rounded segments; requires Powerline glyphs (e.g. a Nerd Font).
interval = 5

[colors]
base = #3c3836
text = #fbf1c7
orange = #d65d0e
yellow = #d79921
aqua = #689d6a
muted = #bdae93
success = #b8bb26
failure = #fb4934

[line.rule]
text = "#[fg=yellow]#(fill:━)"

# Show user/host/load until Starship or `update prompt` supplies a value.
[line.prompt]
default = "#[fg=text,bg=orange,bold] #(command:system.user) #[fg=base,bg=yellow] #(command:system.host) "
default .= "#[fg=base,bg=aqua,nobold] load #(command:system.load) "
text = "#[default,fg=text,bg=base]#(value)"
# Reset value styles before filling the gap and drawing the right side.
text .= "#[default,fg=text,bg=base]#(fill: )"
text .= "#[fg=base,bg=aqua] #(command:system.weather) #[fg=base,bg=yellow,bold] #(datetime:%H:%M:%S) #[default,fg=text,bg=base]"

# Lines created by `statusbar new`.
[push]
spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
text = "#[fg=muted,bg=base]#[fg=yellow]#(spinner)#[default,fg=muted,bg=base] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
done = "#[fg=muted,bg=base]· #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
success = "#[fg=muted,bg=base]#[fg=success]✔#[default,fg=muted,bg=base] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )"
failed = "#[fg=muted,bg=base]#[fg=failure]✗#[default,fg=muted,bg=base] #[fg=text,bold]#(name)#[default,fg=muted,bg=base] › #(value)#(fill: )#[fg=failure]failed#[default,fg=muted,bg=base]"

[command.system.user]
run = whoami
interval = 3600

[command.system.host]
run = hostname -s
interval = 3600

[command.system.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.system.weather]
run = curl https://wttr.in/\?format="%c%t+%m"
interval = 300
