# Inspired by https://starship.rs/presets/gruvbox-rainbow
# Warm rectangular segments; no Powerline font required.
lines = 2
interval = 5

[colors]
base = #3c3836
text = #fbf1c7
orange = #d65d0e
yellow = #d79921
aqua = #689d6a
muted = #bdae93

[line.1]
rule = ━
style = fg=yellow

[line.2]
style = fg=text,bg=base
left = "#[fg=text,bg=orange,bold] #(whoami) #[fg=base,bg=yellow] #(hostname -s) #[default]  #[fg=muted]load #[fg=yellow]#(load)#[default]"
right = "#[fg=base,bg=aqua] #(weather) #[default] #[fg=muted]%a %d #[default] #[fg=base,bg=yellow,bold] %H:%M:%S #[default]"

[command.load]
run = uptime | awk -F'load averages?: ' '{ split($2, a, /[, ]+/); print a[1] }'
interval = 10

[command.weather]
run = curl https://wttr.in/\?format="%c%t%m"
interval = 300

